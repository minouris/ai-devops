{
  "name": "Claude Code Dev Container",
  "image": "mcr.microsoft.com/devcontainers/base:ubuntu-22.04",  
  "runArgs": ["--env-file", ".devcontainer/.env"],
  "features": {
    "ghcr.io/devcontainers/features/github-cli:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/git:1": {
      "version": "latest"
    },
    "ghcr.io/devcontainers/features/python:1": {
      "version": "latest"
    }
  },
  "initializeCommand": "mkdir -p .devcontainer/.claude-data",
  
  "customizations": {
    "vscode": {
      "extensions": [
        "anthropic.claude-code",
        "vstirbu.vscode-mermaid-preview",
        "ms-vscode.vscode-websearchforcopilot"
      ],
      "settings": {
        "claudeCode.disableLoginPrompt": true,
        "claudeCode.environmentVariables": [
          {
            "name": "CLAUDE_CODE_USE_FOUNDRY",
            "value": "1"
          },
          {
            "name": "ANTHROPIC_FOUNDRY_RESOURCE",
            "value": "${containerEnv:ANTHROPIC_FOUNDRY_RESOURCE}"
          },
          {
            "name": "ANTHROPIC_FOUNDRY_API_KEY",
            "value": "${containerEnv:ANTHROPIC_FOUNDRY_API_KEY}"
          },
          {
            "name": "ANTHROPIC_DEFAULT_SONNET_MODEL",
            "value": "${containerEnv:ANTHROPIC_DEFAULT_SONNET_MODEL}"
          },
          {
            "name": "ANTHROPIC_DEFAULT_HAIKU_MODEL",
            "value": "${containerEnv:ANTHROPIC_DEFAULT_HAIKU_MODEL}"
          },
          {
            "name": "CLAUDE_CODE_DISABLE_NONESSENTIAL_TRAFFIC",
            "value": "1"
          }
        ],
        "chat.useClaudeMdFile": true,
        "chat.rulesLocations": [
          "${containerWorkspaceFolder}/src/claude/rules"
        ],
        "chat.skillsLocations": [
          "${containerWorkspaceFolder}/src/claude/skills"
        ],
        "chat.instructionsFilesLocations": [
          "${containerWorkspaceFolder}/src/claude"
        ],
        "chat.useAgentsMdFile": true
      }
    }
  },

  "remoteEnv": {
    "ZSCALER_ROOT_CA": "${containerEnv:ZSCALER_ROOT_CA}",
    "ANTHROPIC_FOUNDRY_RESOURCE": "${containerEnv:ANTHROPIC_FOUNDRY_RESOURCE}",
    "ANTHROPIC_FOUNDRY_API_KEY": "${containerEnv:ANTHROPIC_FOUNDRY_API_KEY}",
    "ANTHROPIC_DEFAULT_SONNET_MODEL": "${containerEnv:ANTHROPIC_DEFAULT_SONNET_MODEL}",
    "ANTHROPIC_DEFAULT_HAIKU_MODEL": "${containerEnv:ANTHROPIC_DEFAULT_HAIKU_MODEL}"
  },

  "mounts": [
    "source=${localWorkspaceFolder}/.devcontainer/.claude-data,target=/home/vscode/.claude,type=bind,consistency=cached",
    "source=${localWorkspaceFolder}/src/claude,target=${containerWorkspaceFolder}/.claude,type=bind,consistency=cached"
  ]
}

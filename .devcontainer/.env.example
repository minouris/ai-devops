# Example environment variables for the dev container
# Copy this file to .env and fill in your values

# Your Anthropic Foundry Resource Name
ANTHROPIC_FOUNDRY_RESOURCE=your-resource-name-here

# Your Anthropic Foundry Base URL e.g. https://your-resource-name.region.services.ai.azure.com/anthropic
ANTHROPIC_FOUNDRY_BASE_URL=your-base-url-here

# Your Anthropic Foundry API Key
ANTHROPIC_FOUNDRY_API_KEY=your-api-key-here

# Your default Sonnet model name
ANTHROPIC_DEFAULT_SONNET_MODEL=your-model-name-here

# Your default Haiku model name (for WebFetch and other tools)
ANTHROPIC_DEFAULT_HAIKU_MODEL=your-haiku-model-name-here

# Your Zscaler Root CA certificate path
ZSCALER_ROOT_CA=/path/to/your/Zscaler_Root_CA.crt
